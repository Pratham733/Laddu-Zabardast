{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Frontend (Vite)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Frontend (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:7000",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
